// Copy this file to Secrets.xcconfig (gitignored) and fill in real values
// from the Supabase dashboard (Settings -> API). Never commit real values.
//
// NOTE: xcconfig treats `//` as a comment start, so URLs must break up the
// double slash with an empty macro expansion: https:/$()/example.com

SUPABASE_URL = https:/$()/YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY = YOUR_PUBLISHABLE_OR_ANON_KEY
