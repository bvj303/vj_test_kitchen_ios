<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared container the app writes and the widget extension reads (see
	     WidgetDataStore). iOS uses the bare group. form; macOS needs the Team ID
	     prefix (see VJTestKitchen-macOS.entitlements + WidgetSharedConfig). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.bvj303.vjtestkitchen</string>
	</array>
</dict>
</plist>
