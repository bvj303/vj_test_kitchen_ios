<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Custom URL scheme so Supabase email-confirmation links redirect back
	     into the app (vjtestkitchen://login-callback) instead of a dead web
	     page. Handled in VJTestKitchenApp's .onOpenURL. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.bvj303.vjtestkitchen.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>vjtestkitchen</string>
			</array>
		</dict>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.1</string>
	<key>CFBundleVersion</key>
	<string>3</string>
	<!-- Export-compliance: the app uses only standard HTTPS/TLS and Apple's
	     built-in crypto (Keychain session storage), all export-exempt. Declaring
	     this false means App Store Connect / TestFlight won't prompt the
	     export-compliance question on every build upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations~iphone</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>VJ Test Kitchen exports your grocery list to a Reminders list so you can check items off while shopping.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>VJ Test Kitchen uses your location to show a local weather outlook on your meal calendar, so you can plan meals around the forecast.</string>
</dict>
</plist>
